# TinaCMS Cloud credentials — get these from https://app.tina.io (Project > Overview / Tokens)
# NEXT_PUBLIC_TINA_CLIENT_ID: project Client ID (public, safe to expose)
# TINA_TOKEN: Read Only Token authorized for branch main (or *)
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# SEO / analytics foundation
# NEXT_PUBLIC_GA_MEASUREMENT_ID: GA4 Measurement ID, e.g. G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION: Google Search Console HTML tag content value
# NEXT_PUBLIC_BING_SITE_VERIFICATION: Bing Webmaster Tools msvalidate.01 content value
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
